# Append to the HUB's existing environment; do not replace its accounts/config.
# Reuse the existing HTTPS origin (including the external port).
MARKET_PUBLIC_URL=https://YOUR_HUB_IP:8444
CENNIK_SOURCE_DIR=/opt/cennik
# EXACT existing server --root directory (contains markets.json and upstreams/).
# Leave blank until verified; a different empty directory would lose the old token.
CENNIK_DATA_DIR=
# Set to: id -u cennik / id -g cennik, preserving access to existing token files.
CENNIK_UID=
CENNIK_GID=
# Reuse the current CENNIK_OWNER_KEY from the server's private environment.
CENNIK_OWNER_KEY=
# Generate ONCE: openssl rand -hex 32. Same value in both containers.
CENNIK_HUB_SECRET=
CENNIK_MEMORY_LIMIT=3g
CENNIK_CPUS=2
