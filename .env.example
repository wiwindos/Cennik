# Public API works without a key. Secrets are read from environment, never from source.
# PowerShell: $env:AHL_API_KEY = 'your-read-only-key'
AHL_API_KEY=
# Optional header name if your API key's instructions specify it.
AHL_API_KEY_HEADER=X-API-Key
# Relative to your working directory or an absolute Windows path.
AHL_DATA_DIR=data

# Docker Compose reads .env. Use a unique secret: openssl rand -hex 32
AHL_WEB_API_KEY=
# Public IPv4 of the Ubuntu/Debian server. TCP 80 and 443 must be reachable.
AHL_PUBLIC_IP=
